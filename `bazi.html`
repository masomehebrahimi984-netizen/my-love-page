<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>ASL BOUTIQUE</title>
<style>
:root{--pink:#ef9fbe;--deep:#9d4269;--cream:#fff7fa;--ink:#392532;--gold:#e4b85e}*{box-sizing:border-box}body{margin:0;background:linear-gradient(145deg,#fff1f7,#f8dce9);font-family:Tahoma,Arial,sans-serif;color:var(--ink)}button{font:inherit;cursor:pointer;border:0;border-radius:16px;padding:12px 16px;background:var(--deep);color:white;box-shadow:0 4px 0 #71304d}button:active{transform:translateY(3px);box-shadow:0 1px 0 #71304d}.wrap{max-width:980px;margin:auto;padding:16px}.top{background:#fffafc;border:2px solid #f4c8d9;border-radius:24px;padding:16px;text-align:center;box-shadow:0 8px 24px #a84c7020}.brand{font-family:Georgia,serif;letter-spacing:2px;color:var(--deep);font-size:clamp(28px,6vw,46px);font-weight:bold}.sub{color:#98617a;margin-top:5px}.stats{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:14px}.pill{background:#fff0f6;border:1px solid #f0c2d4;border-radius:999px;padding:8px 14px;font-weight:bold}.layout{display:grid;grid-template-columns:1.15fr .85fr;gap:14px;margin-top:14px}.panel{background:#fffafc;border:2px solid #f2cada;border-radius:22px;padding:16px;box-shadow:0 8px 24px #a84c7015}.shop{min-height:330px;background:linear-gradient(#fff5fa,#f9dce9);position:relative;overflow:hidden}.shop:before{content:'✦';position:absolute;top:15px;left:25px;color:#e5b55c;font-size:30px}.shop h2{text-align:center;color:var(--deep);margin:4px 0 16px}.rack{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}.dress{width:105px;height:142px;border-radius:18px;background:white;border:2px solid #f1c5d6;display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:42px;box-shadow:0 5px 12px #9c42691a}.dress small{font-size:12px;color:#75435a;margin-top:6px}.avatar{font-size:58px;text-align:center;margin:10px}.speech{background:white;border:1px solid #efc3d5;border-radius:18px;padding:12px;margin:12px 0;line-height:1.9}.choices{display:grid;grid-template-columns:1fr 1fr;gap:9px}.choices button{background:#bd6d91}.muted{color:#946d80;font-size:13px;line-height:1.8}.mission{background:#fff1d5;border:1px solid #f1d59b;border-radius:16px;padding:12px;margin-top:12px}.hidden{display:none}.wide{width:100%;margin-top:10px}.toast{min-height:26px;color:#8e3f64;font-weight:bold;text-align:center;margin-top:10px}.footer{text-align:center;color:#98617a;font-size:12px;margin:16px}
@media(max-width:700px){.layout{grid-template-columns:1fr}.shop{min-height:300px}.panel{padding:13px}}
</style>
</head>
<body><div class="wrap">
<header class="top"><div class="brand">ASL BOUTIQUE</div><div class="sub">بوتیک رؤیایی معصومه</div><div class="stats"><span class="pill">⭐ مرحله <b id="level">۱</b></span><span class="pill">🪙 سکه <b id="coins">۱۰۰</b></span><span class="pill">🌟 امتیاز <b id="points">۰</b></span></div></header>
<div id="home" class="panel" style="margin-top:14px;text-align:center"><div style="font-size:70px">🎀</div><h2 style="color:var(--deep)">به بوتیک معصومه خوش اومدی!</h2><p>لباس مناسب مشتری رو پیدا کن، رضایت بگیر و بوتیکت رو بزرگ‌تر کن.</p><button class="wide" onclick="startGame()">شروع بازی</button><p class="muted">نسخه آزمایشی اول • بازی به زبان فارسی</p></div>
<div id="game" class="layout hidden">
<section class="panel shop"><h2>🏬 بوتیک ASL</h2><div class="avatar">👩🏻‍💼</div><div class="muted" style="text-align:center">معصومه، آماده راهنمایی مشتری‌هاست!</div><div class="rack"><div class="dress">🧥<small>هودی</small></div><div class="dress">👕<small>تی‌شرت</small></div><div class="dress">👖<small>شلوار</small></div><div class="dress">🧶<small>بافت</small></div></div><div class="mission"><b>📒 مأموریت امروز</b><div id="missionText">به اولین مشتری کمک کن لباس مناسبش رو پیدا کنه.</div></div></section>
<aside class="panel"><h2 style="color:var(--deep);margin-top:0">🛍️ مشتری بوتیک</h2><div class="avatar" id="customerFace">👧🏻</div><h3 id="customerName" style="text-align:center">تندیس</h3><div class="speech" id="dialogue">سلام معصومه! دنبال یک لباس تینیجری راحت و صورتی می‌گردم.</div><b>چه پیشنهادی می‌دی؟</b><div class="choices" style="margin-top:10px"><button onclick="choose('تینیجری')">لباس تینیجری</button><button onclick="choose('اسپرت')">لباس اسپرت</button><button onclick="choose('روزمره')">لباس روزمره</button><button onclick="choose('مینیمال')">لباس شیک و مینیمال</button></div><div class="toast" id="feedback"></div><button class="wide" style="background:#bd8a39" onclick="nextCustomer()">مشتری بعدی</button><p class="muted">مشتری‌های ثابت: تندیس، دلوین، ماهلین و آیلین</p></aside>
</div><div class="footer">ASL BOUTIQUE • ساخته‌شده برای سرگرمی و خلاقیت 💗</div></div>
<script>
const customers=[
{name:'تندیس',face:'👧🏻',want:'تینیجری',line:'سلام معصومه! دنبال یک لباس تینیجری راحت و صورتی می‌گردم.'},
{name:'دلوین',face:'👩🏻',want:'اسپرت',line:'سلام! یه لباس اسپرت و راحت برای بیرون می‌خوام.'},
{name:'ماهلین',face:'👩🏽',want:'مینیمال',line:'سلام معصومه! لباس ساده، مرتب و شیک دوست دارم.'},
{name:'آیلین',face:'👩🏼',want:'روزمره',line:'سلام! یه لباس روزمره و خوش‌رنگ می‌خوام.'}
];let index=0,coins=100,points=0,level=1,answered=false;
function startGame(){document.getElementById('home').classList.add('hidden');document.getElementById('game').classList.remove('hidden');showCustomer()}
function showCustomer(){let c=customers[index%customers.length];document.getElementById('customerName').textContent=c.name;document.getElementById('customerFace').textContent=c.face;document.getElementById('dialogue').textContent=c.line;document.getElementById('feedback').textContent='';document.getElementById('missionText').textContent='لباس موردعلاقه '+c.name+' رو پیدا کن.';answered=false}
function choose(style){if(answered){document.getElementById('feedback').textContent='اول مشتری بعدی رو انتخاب کن!';return}answered=true;let c=customers[index%customers.length];if(style===c.want){coins+=25;points+=5;document.getElementById('feedback').textContent='آفرین! مشتری خیلی راضیه ⭐⭐⭐⭐⭐  +۲۵ سکه';document.getElementById('dialogue').textContent='وای، دقیقاً همون چیزیه که می‌خواستم! ممنون معصومه!';}else{coins+=5;points+=1;document.getElementById('feedback').textContent='انتخاب بدی نیست، ولی سلیقه مشتری چیز دیگه‌ای بود. ⭐⭐  +۵ سکه';document.getElementById('dialogue').textContent='ممنون! می‌شه یه مدل دیگه هم بهم نشون بدی؟';}if(points>=10){level=Math.floor(points/10)+1}document.getElementById('coins').textContent=coins;document.getElementById('points').textContent=points;document.getElementById('level').textContent=level}
function nextCustomer(){index++;showCustomer()}
</script></body></html>
